# Copy to .env.production and fill in real values.
# Do not commit .env.production. Do not bake this file into Docker images.
#
#   cp .env.production.example .env.production
#   docker compose --env-file .env.production -f docker-compose.prod.yml up -d --build

# Public origin used in generated short URLs (required; no localhost fallback in prod).
BASE_URL=https://your-domain.com

# Host port mapped to the frontend nginx container (TLS terminates in front of this).
FRONTEND_HOST_PORT=80

# PostgreSQL (not the default postgres/postgres pair)
POSTGRES_USER=urlshortner
POSTGRES_PASSWORD=change-me-to-a-long-random-secret
POSTGRES_DB=urlshortner

COOKIE_SECURE=true

# Redis AUTH (required in production Compose; leave unset locally if Redis has no password)
REDIS_PASSWORD=
